#include<stdio.h>
#include<conio.h>
#include<string.h>
void revstring(char s[])
{
    char temp;
    int len=strlen(s);
    int i,j;
    for(i=0,j=len-1;i<j;i++,j--)
    {
        temp=s[i];
        s[i]=s[j];
        s[j]=temp;
    }
}
int main()
{
    char s[]="hello";
    revstring(s);
    printf("Reverse: %s",s);
}
